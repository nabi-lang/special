//! Special functions of mathematical physics and statistics, over f64
//! and, where standard, Complex<f64>. The functions are scalar and follow
//! SciPy's names; `f.(x)` maps one over an array and `apply` does it on
//! all cores. A domain error gives NaN; only the table builders throw
//! `SpecialError`. Pure Nabi, so it builds for every target, wasm included.

pub mod notation;

mod airy;
mod apply;
mod bessel;
mod betas;
mod combinatorics;
mod complex;
mod elementary;
mod elliptic;
mod error;
mod expint;
mod faddeeva;
mod fresnel;
mod gammas;
mod lambert;
mod legendre;
mod logistic;
mod normal;
mod orthopoly;
mod polygamma;
mod struve;
mod zeta;

