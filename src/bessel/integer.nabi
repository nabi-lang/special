const J01: (f64, f64) = (2.404825557695773, -1.176691651530894e-16);
const J02: (f64, f64) = (5.520078110286311, 8.088597146146722e-17);
const J11: (f64, f64) = (3.8317059702075125, -1.5269184090088067e-16);
const J12: (f64, f64) = (7.015586669815619, -9.414165653410389e-17);

/// `(x - z) (x + z)` for the zero `z = h + l`.
fn around(x: f64, z: (f64, f64)) -> f64 { ((x - z.0) - z.1) * (x + z.0) }

/// `(P, Q)` of order 0 or 1 for `x > 8`, `Q` already divided by `x`.
fn pq(n: i32, x: f64) -> (f64, f64) {
    let u = 64.0 / (x * x);
    if n == 0 { (cheb(P0, 0.0, 1.0, u), cheb(Q0, 0.0, 1.0, u) / x) } else { (cheb(P1, 0.0, 1.0, u), cheb(Q1, 0.0, 1.0, u) / x) }
}

/// The Bessel function of the first kind of order 0, `J0(x)`. About 2
/// ulp up to 8 (its zeros 2.40 and 5.52 included); past 8 the error is
/// about 1e-16 absolute, so the relative error grows near the zeros.
/// SciPy: `j0`.
///
/// ```nabi
/// assert(special::j0(0.0) == 1.0);
/// assert((special::j0(1.0) - 0.7651976865579666).abs() < 2e-16);
/// ```
pub fn j0(x: f64) -> f64 {
    let a = x.abs();
    // Near 0 the leading terms, exact at 0.
    if a < 1e-5 { return 1.0 - 0.25 * a * a; }
    if a <= 8.0 { return cheb(J0S, 0.0, 64.0, a * a) * around(a, J01) * around(a, J02); }
    if a == f64::INFINITY { return 0.0; }
    let (p, q) = pq(0, a);
    ((p + q) * a.cos() + (p - q) * a.sin()) / (SQRT_PI * a.sqrt())
}

/// The Bessel function of the first kind of order 1, `J1(x)`, odd in
/// `x`. About 2 ulp up to 8, about 1e-16 absolute past it. SciPy: `j1`.
///
/// ```nabi
/// assert((special::j1(1.0) - 0.44005058574493355).abs() < 3e-16);
/// assert(special::j1(-1.0) == -special::j1(1.0));
/// ```
pub fn j1(x: f64) -> f64 {
    let a = x.abs();
    let r = if a < 1e-5 {
        0.5 * a * (1.0 - 0.125 * a * a)
    } else if a <= 8.0 {
        a * cheb(J1S, 0.0, 64.0, a * a) * around(a, J11) * around(a, J12)
    } else if a == f64::INFINITY {
        0.0
    } else {
        let (p, q) = pq(1, a);
        ((p + q) * a.sin() - (p - q) * a.cos()) / (SQRT_PI * a.sqrt())
    };
    if x < 0.0 { -r } else { r }
}

/// The Bessel function of the second kind of order 0, `Y0(x)`, for `x >
/// 0`: `-inf` at 0, NaN below. About 1e-16 absolute (relative near the
/// zeros grows as 1 / Y0). SciPy: `y0`.
///
/// ```nabi
/// assert((special::y0(1.0) - 0.08825696421567697).abs() < 3e-16);
/// assert(special::y0(0.0) == f64::NEG_INFINITY);
/// ```
pub fn y0(x: f64) -> f64 {
    if !(x >= 0.0) { return f64::NAN; }
    if x == 0.0 { return f64::NEG_INFINITY; }
    if x <= 8.0 { return cheb(Y0S, 0.0, 64.0, x * x) + FRAC_2_PI * x.ln() * j0(x); }
    if x == f64::INFINITY { return 0.0; }
    let (p, q) = pq(0, x);
    ((p + q) * x.sin() - (p - q) * x.cos()) / (SQRT_PI * x.sqrt())
}

/// The Bessel function of the second kind of order 1, `Y1(x)`, for `x >
/// 0`: `-inf` at 0, NaN below. About 1e-16 absolute. SciPy: `y1`.
///
/// ```nabi
/// assert((special::y1(1.0) + 0.7812128213002887).abs() < 3e-16);
/// ```
pub fn y1(x: f64) -> f64 {
    if !(x >= 0.0) { return f64::NAN; }
    if x == 0.0 { return f64::NEG_INFINITY; }
    if x <= 8.0 { return x * cheb(Y1S, 0.0, 64.0, x * x) + FRAC_2_PI * (j1(x) * x.ln() - 1.0 / x); }
    if x == f64::INFINITY { return 0.0; }
    let (p, q) = pq(1, x);
    -((p - q) * x.sin() + (p + q) * x.cos()) / (SQRT_PI * x.sqrt())
}

/// `I0(x) e^-|x|`, the exponentially scaled modified Bessel function of
/// order 0. About 2 ulp. SciPy: `i0e`.
///
/// ```nabi
/// assert((special::i0e(1000.0) - 0.012617240455891257).abs() < 1e-17);
/// ```
pub fn i0e(x: f64) -> f64 {
    let a = x.abs();
    if a < 1e-5 { return (1.0 + 0.25 * a * a) * (-a).exp(); }
    if a <= 8.0 { return cheb(I0S, 0.0, 8.0, a); }
    cheb(I0L, 0.0, 1.0, 8.0 / a) / a.sqrt()
}

/// The modified Bessel function of the first kind of order 0, `I0(x)`,
/// even in `x`; `inf` past 713.9. About 2 ulp. SciPy: `i0`.
///
/// ```nabi
/// assert(special::i0(0.0) == 1.0);
/// assert((special::i0(1.0) - 1.2660658777520082).abs() < 3e-16);
/// ```
pub fn i0(x: f64) -> f64 {
    let a = x.abs();
    if a < 1e-5 { return 1.0 + 0.25 * a * a; }
    if a <= 8.0 { return cheb(I0S, 0.0, 8.0, a) * a.exp(); }
    let h = (0.5 * a).exp();
    cheb(I0L, 0.0, 1.0, 8.0 / a) / a.sqrt() * h * h
}

/// `I1(x) e^-|x|`, odd in `x`. About 2 ulp. SciPy: `i1e`.
///
/// ```nabi
/// assert((special::i1e(1.0) - 0.2079104153497085).abs() < 3e-16);
/// ```
pub fn i1e(x: f64) -> f64 {
    let a = x.abs();
    let r = if a < 1e-5 { 0.5 * a * (1.0 + 0.125 * a * a) * (-a).exp() } else if a <= 8.0 { a * cheb(I1S, 0.0, 8.0, a) } else { cheb(I1L, 0.0, 1.0, 8.0 / a) / a.sqrt() };
    if x < 0.0 { -r } else { r }
}

/// The modified Bessel function of the first kind of order 1, `I1(x)`,
/// odd in `x`. About 2 ulp. SciPy: `i1`.
///
/// ```nabi
/// assert((special::i1(1.0) - 0.5651591039924851).abs() < 2e-16);
/// ```
pub fn i1(x: f64) -> f64 {
    let a = x.abs();
    let r = if a < 1e-5 {
        0.5 * a * (1.0 + 0.125 * a * a)
    } else if a <= 8.0 {
        a * cheb(I1S, 0.0, 8.0, a) * a.exp()
    } else {
        let h = (0.5 * a).exp();
        cheb(I1L, 0.0, 1.0, 8.0 / a) / a.sqrt() * h * h
    };
    if x < 0.0 { -r } else { r }
}

/// The modified Bessel function of the second kind of order 0, `K0(x)`,
/// `x > 0`: `inf` at 0, NaN below. About 2 ulp. SciPy: `k0`.
///
/// ```nabi
/// assert((special::k0(1.0) - 0.42102443824070834).abs() < 3e-16);
/// ```
pub fn k0(x: f64) -> f64 {
    if !(x >= 0.0) { return f64::NAN; }
    if x == 0.0 { return f64::INFINITY; }
    if x <= 1.0 { return cheb(K0S, 0.0, 1.0, x * x) - x.ln() * i0(x); }
    cheb(K0L, 0.0, 1.0, 1.0 / x) / x.sqrt() * (-x).exp()
}

/// `K0(x) e^x`. About 2 ulp. SciPy: `k0e`.
///
/// ```nabi
/// assert((special::k0e(1000.0) - 0.03962832160075422).abs() < 1e-17);
/// ```
pub fn k0e(x: f64) -> f64 {
    if !(x >= 0.0) { return f64::NAN; }
    if x == 0.0 { return f64::INFINITY; }
    if x <= 1.0 { return k0(x) * x.exp(); }
    cheb(K0L, 0.0, 1.0, 1.0 / x) / x.sqrt()
}

/// The modified Bessel function of the second kind of order 1, `K1(x)`,
/// `x > 0`. About 2 ulp. SciPy: `k1`.
///
/// ```nabi
/// assert((special::k1(1.0) - 0.6019072301972346).abs() < 2e-16);
/// ```
pub fn k1(x: f64) -> f64 {
    if !(x >= 0.0) { return f64::NAN; }
    if x == 0.0 { return f64::INFINITY; }
    if x <= 1.0 { return x * cheb(K1S, 0.0, 1.0, x * x) + x.ln() * i1(x) + 1.0 / x; }
    cheb(K1L, 0.0, 1.0, 1.0 / x) / x.sqrt() * (-x).exp()
}

/// `K1(x) e^x`. About 2 ulp. SciPy: `k1e`.
///
/// ```nabi
/// assert((special::k1e(1.0) - 1.636153486263258).abs() < 4e-16);
/// ```
pub fn k1e(x: f64) -> f64 {
    if !(x >= 0.0) { return f64::NAN; }
    if x == 0.0 { return f64::INFINITY; }
    if x <= 1.0 { return k1(x) * x.exp(); }
    cheb(K1L, 0.0, 1.0, 1.0 / x) / x.sqrt()
}

/// `J_n(x)` for `0 < x < n`: the power series below 1, else Miller's
/// backward recurrence `J_k-1 = (2k / x) J_k - J_k+1` from zero at an
/// order m where the forward recurrence from (0, 1) at n has grown past
/// 1 / eps, which puts the error of the start far below the rounding at
/// n (Gautschi 1967), normalized by `J0 + 2 (J2 + J4 + ...) = 1` and
/// rescaled as it grows.
fn below(n: i32, x: f64) -> f64 {
    if x < 1.0 { return series(n as f64, x, -1.0); }
    let (p, q) = (0.0, 1.0);
    let m = n;
    while q.abs() < 1.0 / EPS {
        let t = 2.0 * m as f64 / x * q - p;
        p = q;
        q = t;
        m += 1;
    }
    m += 1;
    // f = F_k, g = F_k+1; s gathers 2 F_k over the even k > 0.
    let (f, g) = (1.0, 0.0);
    let (s, want) = (0.0, 0.0);
    let k = m;
    while k > 0 {
        let t = 2.0 * k as f64 / x * f - g;
        g = f;
        f = t;
        k -= 1;
        if f.abs() > 1e250 {
            f *= 1e-250;
            g *= 1e-250;
            s *= 1e-250;
            want *= 1e-250;
        }
        if k == n { want = f; }
        if k % 2 == 0 && k > 0 { s += 2.0 * f; }
    }
    want / (s + f)
}

/// The Bessel function of the first kind of integer order, `J_n(x)`:
/// forward recurrence from J0 and J1 where it is stable (`x >= n`);
/// below that the power series for `x < 1`, else Miller's backward
/// recurrence. `J_-n = (-1)^n J_n`, `J_n(-x) = (-1)^n J_n(x)`. About
/// 1e-15 relative off the zeros. SciPy: `jn`.
///
/// ```nabi
/// assert((special::jn(5, 2.0) - 0.007039629755871685).abs() < 1e-18);
/// assert(special::jn(-1, 1.0) == -special::j1(1.0));
/// ```
pub fn jn(n: i32, x: f64) -> f64 {
    if x != x { return x; }
    if n < 0 {
        let r = jn(-n, x);
        return if n % 2 == 0 { r } else { -r };
    }
    if x < 0.0 {
        let r = jn(n, -x);
        return if n % 2 == 0 { r } else { -r };
    }
    if n == 0 { return j0(x); }
    if n == 1 { return j1(x); }
    if x == 0.0 || x == f64::INFINITY { return 0.0; }
    if x >= n as f64 {
        let (a, b) = (j0(x), j1(x));
        for k in 1..n {
            let c = 2.0 * k as f64 / x * b - a;
            a = b;
            b = c;
        }
        return b;
    }
    below(n, x)
}

/// The Bessel function of the second kind of integer order, `Y_n(x)`,
/// `x > 0`, by forward recurrence from Y0 and Y1 (always stable for Y);
/// `-inf` once it overflows. `Y_-n = (-1)^n Y_n`. About 1e-15 relative
/// off the zeros. SciPy: `yn`.
///
/// ```nabi
/// assert((special::yn(3, 2.0) + 1.1277837768404278).abs() < 1e-15);
/// ```
pub fn yn(n: i32, x: f64) -> f64 {
    if n < 0 {
        let r = yn(-n, x);
        return if n % 2 == 0 { r } else { -r };
    }
    if n == 0 { return y0(x); }
    if !(x >= 0.0) { return f64::NAN; }
    if x == 0.0 { return f64::NEG_INFINITY; }
    let (a, b) = (y0(x), y1(x));
    for k in 1..n {
        let c = 2.0 * k as f64 / x * b - a;
        a = b;
        b = c;
        if b == f64::NEG_INFINITY { return b; }
    }
    b
}

/// The modified Bessel function of the second kind of integer order,
/// `K_n(x)`, `x > 0`, by forward recurrence from K0 and K1 (stable);
/// `K_-n = K_n`. About 1e-15 relative. SciPy: `kn`.
///
/// ```nabi
/// assert((special::kn(3, 2.0) - 0.6473853909486342).abs() < 1e-15);
/// ```
pub fn kn(n: i32, x: f64) -> f64 {
    let m = if n < 0 { -n } else { n };
    if m == 0 { return k0(x); }
    if !(x >= 0.0) { return f64::NAN; }
    if x == 0.0 { return f64::INFINITY; }
    let (a, b) = (k0(x), k1(x));
    for k in 1..m {
        let c = 2.0 * k as f64 / x * b + a;
        a = b;
        b = c;
        if b == f64::INFINITY { return b; }
    }
    b
}

/// `K_n(x) e^x`, the same recurrence on the scaled pair.
pub(pkg) fn kne(n: i32, x: f64) -> f64 {
    let m = if n < 0 { -n } else { n };
    if m == 0 { return k0e(x); }
    if !(x >= 0.0) { return f64::NAN; }
    if x == 0.0 { return f64::INFINITY; }
    let (a, b) = (k0e(x), k1e(x));
    for k in 1..m {
        let c = 2.0 * k as f64 / x * b + a;
        a = b;
        b = c;
        if b == f64::INFINITY { return b; }
    }
    b
}
