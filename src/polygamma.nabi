// The polygamma functions psi^(n)(x) = (-1)^(n+1) n! zeta(n + 1, x),
// through the Hurwitz zeta function (Abramowitz and Stegun 6.4.10).

use pkg::gammas::{digamma, gamma, lgamma, trigamma};
use pkg::zeta::{hurwitz, ln_hurwitz};

/// The polygamma function `psi^(n)(x)`, the n-th derivative of the
/// digamma function: `digamma` for `n = 0`, `trigamma` for `n = 1` and
/// `x > 0`, and `(-1)^(n+1) n! zeta(n + 1, x)` otherwise, the Hurwitz
/// sum running over the shifted terms for `x < 0`. About 5 ulp for `x >
/// 0` (1.1e-15 measured; logs added where `n!` or the sum would
/// overflow alone), absolute accuracy for `x < 0` near the zeros. At the poles 0, -1, -2, ...:
/// `+inf` for odd `n` (both sides go up), NaN for even `n`. SciPy:
/// `polygamma`.
///
/// ```nabi
/// // psi''(1) = -2 zeta(3).
/// assert((special::polygamma(2, 1.0) + 2.4041138063191885).abs() < 1e-15);
/// assert(special::polygamma(1, 1.0) == special::trigamma(1.0));
/// assert(special::polygamma(1, -2.0) == f64::INFINITY);
/// ```
pub fn polygamma(n: u32, x: f64) -> f64 {
    if x != x { return x; }
    if n == 0u32 { return digamma(x); }
    if n == 1u32 && x > 0.0 { return trigamma(x); }
    let odd = n % 2u32 == 1u32;
    if x <= 0.0 && x == x.floor() { return if odd { f64::INFINITY } else { f64::NAN }; }
    if x == f64::INFINITY { return 0.0; }
    let s = n as f64 + 1.0;
    let sign = if odd { 1.0 } else { -1.0 };
    if n <= 170u32 {
        let z = hurwitz(s, x);
        let r = gamma(s) * z;
        // n! zeta(n + 1, x) overflows in one factor or underflows in
        // the other only where x > 1 keeps the result finite.
        if (r.is_finite() && z.abs() > 1e-300) || x <= 1.0 { return sign * r; }
    } else if x <= 1.0 {
        return sign * f64::INFINITY;
    }
    sign * (lgamma(s) + ln_hurwitz(s, x)).exp()
}
