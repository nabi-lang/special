fn eval(code: f64, n: u32, a: f64, b: f64, x: f64) -> f64 {
    match code as i64 {
        0 => pkg::eval_legendre(n, x),
        1 => pkg::eval_chebyt(n, x),
        2 => pkg::eval_chebyu(n, x),
        3 => pkg::eval_hermite(n, x),
        4 => pkg::eval_hermitenorm(n, x),
        5 => pkg::eval_genlaguerre(n, a, x),
        6 => pkg::eval_gegenbauer(n, a, x),
        _ => pkg::eval_jacobi(n, a, b, x),
    }
}

fn rule(code: f64, n: usize, a: f64, b: f64) -> (Vector<f64>, Vector<f64>) {
    try! match code as i64 {
        0 => pkg::roots_legendre(n),
        3 => pkg::roots_hermite(n),
        4 => pkg::roots_hermitenorm(n),
        5 => pkg::roots_genlaguerre(n, a),
        6 => pkg::roots_gegenbauer(n, a),
        _ => pkg::roots_jacobi(n, a, b),
    }
}

#[test]
fn polynomial_values() {
    for r in EVAL {
        let n = r[1] as u32;
        let got = eval(r[0], n, r[2], r[3], r[4]);
        rel(got, r[5], 8e-16 * (n as f64 + 2.0), f"kind {r[0]} n {n} at {r[4]} ({r[2]}, {r[3]})");
    }
    // Special cases and recurrences.
    expect(pkg::eval_legendre(5, -1.0) == -1.0 && pkg::eval_chebyt(9, -1.0) == -1.0, "ends");
    expect(pkg::eval_chebyt(40, 1.0) == 1.0 && pkg::eval_chebyu(41, -1.0) == -42.0, "Chebyshev ends");
    expect(pkg::eval_gegenbauer(5, 0.0, 0.3) == 0.0, "C^0 is 0");
    expect(pkg::eval_hermite(3, f64::NAN) != pkg::eval_hermite(3, f64::NAN), "nan");
    expect(pkg::eval_hermite(400, 1e3) == f64::INFINITY, "overflow");
    // H_n(x) = 2^(n/2) He_n(x sqrt 2).
    rel(pkg::eval_hermite(12, 0.8), 64.0 * pkg::eval_hermitenorm(12, 0.8 * 2f64.sqrt()), 1e-14, "H and He");
    // P_n^(a, a) and C_n^(a + 1/2) are proportional; P^(0, 0) = P_n.
    for x in [-0.9, 0.1, 0.77] {
        rel(pkg::eval_jacobi(9, 0.0, 0.0, x), pkg::eval_legendre(9, x), 1e-14, f"Jacobi(0, 0) at {x}");
        rel(pkg::eval_gegenbauer(9, 1.0, x), pkg::eval_chebyu(9, x), 1e-14, f"C^1 = U at {x}");
        rel(pkg::eval_genlaguerre(9, 0.0, x), pkg::eval_laguerre(9, x), 1e-16, "L^0 = L");
    }
}

#[test]
fn quadrature_rules() {
    for r in RULES {
        let n = r[1] as usize;
        let (x, w) = rule(r[0], n, r[2], r[3]);
        expect(x.len() == n && w.len() == n, "length");
        let i = r[4] as usize;
        // 4 ulp; 10 for the smallest Laguerre node where the recurrence
        // cancels and a target without fused multiply-add rounds otherwise.
        close(x[i], r[5], 1.2e-15 * r[5].abs().max(1.0), f"node {i} of kind {r[0]} n {n}");
        rel(w[i], r[6], 1e-14, f"weight {i} of kind {r[0]} n {n}");
    }
    // Chebyshev closed forms.
    let (x, w) = try! pkg::roots_chebyt(5);
    expect(x[2] == 0.0 && w[0] == 3.141592653589793 / 5.0, "chebyt");
    close(x[4], (3.141592653589793 / 10.0).cos(), 2e-16, "chebyt node");
    let (y, v) = try! pkg::roots_chebyu(4);
    close(y[3], (3.141592653589793 / 5.0).cos(), 2e-16, "chebyu node");
    let s = 0.0;
    for k in 0..4usize { s += v[k]; }
    close(s, 3.141592653589793 / 2.0, 1e-15, "chebyu weights sum to pi/2");
}

/// sum w_i f(x_i) for f = x^k.
fn moment(x: Vector<f64>, w: Vector<f64>, k: i32) -> f64 {
    let s = 0.0;
    for i in 0..x.len() { s += w[i] * x[i].powi(k); }
    s
}

#[test]
fn exactness() {
    // Gauss-Legendre with n nodes integrates x^k exactly up to 2n - 1.
    for n in [1usize, 4, 17, 64, 150, 1000] {
        let (x, w) = try! pkg::roots_legendre(n);
        close(moment(x, w, 0), 2.0, 2e-15 * (n as f64).sqrt(), f"weights of {n}");
        for k in [2i32, 6, 2 * n as i32 - 2] {
            if k > 2 * n as i32 - 1 { continue; }
            close(moment(x, w, k), 2.0 / (k as f64 + 1.0), 4e-15, f"x^{k} with {n} nodes");
        }
        expect(moment(x, w, 2 * n as i32 - 1).abs() < 1e-15, "odd moment");
        for i in 0..n {
            expect(x[i] == -x[n - 1 - i] && w[i] == w[n - 1 - i], "symmetric");
            if i > 0 { expect(x[i] > x[i - 1], "rising"); }
        }
        // Each node a zero of P_n.
        let i = n / 3;
        expect(pkg::eval_legendre(n as u32, x[i]).abs() < 1e-13, "zero of P_n");
    }
    // Gauss-Hermite: E[x^4] = 3/4 sqrt(pi) for e^-x^2.
    let (x, w) = try! pkg::roots_hermite(20);
    rel(moment(x, w, 4), 0.75 * 3.141592653589793f64.sqrt(), 1e-14, "Hermite x^4");
    // Gauss-Laguerre: integral x^k e^-x = k!.
    let (x, w) = try! pkg::roots_laguerre(12);
    rel(moment(x, w, 15), 1307674368000.0, 1e-13, "Laguerre x^15");
    let (x, w) = try! pkg::roots_genlaguerre(10, 0.5);
    // integral x^3.5 e^-x = Gamma(4.5).
    rel(moment(x, w, 3), 11.631728396567448, 1e-14, "genlaguerre x^3");
    // Gauss-Jacobi with (1 - x)^2: integral (1 - x)^2 x^2 over [-1, 1] = 16/15.
    let (x, w) = try! pkg::roots_jacobi(5, 2.0, 0.0);
    rel(moment(x, w, 2), 16.0 / 15.0, 1e-14, "Jacobi x^2");
    // Large rules stay finite.
    let (x, w) = try! pkg::roots_hermite(500);
    expect(x[499] > 30.0 && x[499] < 32.0 && w[250] > 0.0 && w[0] >= 0.0, "Hermite 500");
}

fn kind_of(f: fn() throws (SpecialError)) -> str {
    try {
        f();
        "none"
    } catch e: SpecialError {
        f"{e}"
    }
}

#[test]
fn errors() {
    expect(kind_of(|| { _ = try pkg::roots_legendre(0); }).contains("n >= 1"), "n = 0");
    expect(kind_of(|| { _ = try pkg::roots_genlaguerre(3, -1.0); }).contains("alpha > -1"), "alpha");
    expect(kind_of(|| { _ = try pkg::roots_jacobi(3, 0.5, -2.0); }).contains("alpha, beta > -1"), "beta");
    expect(kind_of(|| { _ = try pkg::roots_gegenbauer(3, -0.5); }).contains("alpha > -1/2"), "gegenbauer alpha");
    expect(kind_of(|| { _ = try pkg::roots_hermite(1); }) == "none", "n = 1");
}
