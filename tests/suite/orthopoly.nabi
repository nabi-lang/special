// Orthogonal polynomials and Gauss rules against mpmath (40 digits:
// legendre, chebyt, chebyu, hermite, laguerre, gegenbauer, jacobi; the
// probabilists' Hermite as 2^(-n/2) H_n(x / sqrt 2)), the reference
// rules from mpmath's eigsy of the Jacobi matrix at 60 digits. Plus
// exactness on polynomials of degree 2n - 1, the weight sums, symmetry,
// orthogonality, and the errors.

use pkg::SpecialError;
use pkg::tests::suite::{close, expect, rel};
use core::array::Vector;

