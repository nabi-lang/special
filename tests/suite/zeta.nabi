#[test]
fn zeta_values() {
    for r in ZETA {
        let s = r[0];
        // Below 0 the powers of 2 pi carry |s| eps.
        let tol = if s < 0.0 { 2e-16 * (4.0 + s.abs()) } else { 6e-16 };
        rel(pkg::zeta(s), r[1], tol, f"zeta({s})");
    }
    for r in ZETAC {
        let tol = if r[0] < 0.0 { 2e-16 * (4.0 + r[0].abs()) } else { 6e-16 };
        rel(pkg::zetac(r[0]), r[1], tol, f"zetac({r[0]})");
    }
    expect(pkg::zeta(1.0) == f64::INFINITY && pkg::zeta(f64::INFINITY) == 1.0, "pole and limit");
    expect(pkg::zeta(f64::NAN) != pkg::zeta(f64::NAN) && pkg::zeta(f64::NEG_INFINITY) != pkg::zeta(f64::NEG_INFINITY), "nan");
    for k in 1..60 { expect(pkg::zeta(-2.0 * k as f64) == 0.0, f"trivial zero -{2 * k}"); }
    expect(pkg::zeta(-1000.5).is_infinite(), "overflow");
    expect(pkg::zetac(2000.0) == 0.0, "underflow");
    // zeta(1 - s) = 2 (2 pi)^-s cos(pi s / 2) Gamma(s) zeta(s).
    for s in [0.3, 1.7, 2.5, 4.2, 9.9] {
        let pi = 3.141592653589793;
        let want = 2.0 * (2.0 * pi).pow(-s) * pkg::cospi(0.5 * s) * pkg::gamma(s) * pkg::zeta(s);
        rel(pkg::zeta(1.0 - s), want, 4e-15, f"functional equation at {s}");
    }
}

#[test]
fn hurwitz_values() {
    for r in HURWITZ {
        let tol = if r[1] < 0.0 { 1e-14 } else { 6e-16 };
        rel(pkg::hurwitz(r[0], r[1]), r[2], tol, f"zeta({r[0]}, {r[1]})");
    }
    // zeta(s, q) = q^-s + zeta(s, q + 1).
    for s in [1.5, 3.0, 12.0] {
        for q in [0.2, 1.7, 40.0] {
            rel(pkg::hurwitz(s, q), q.pow(-s) + pkg::hurwitz(s, q + 1.0), 1e-15, f"shift at {s}, {q}");
        }
    }
    expect(pkg::hurwitz(1.0, 2.0) == f64::INFINITY && pkg::hurwitz(0.5, 2.0) != pkg::hurwitz(0.5, 2.0), "s <= 1");
    expect(pkg::hurwitz(2.0, -3.0) == f64::INFINITY && pkg::hurwitz(2.5, -0.5) != pkg::hurwitz(2.5, -0.5), "q <= 0");
}

#[test]
fn polygamma_values() {
    for r in POLYGAMMA {
        let (n, x) = (r[0] as u32, r[1]);
        let tol = if x < 0.0 { 2e-14 } else if n > 100u32 { 3e-13 } else { 1e-15 };
        rel(pkg::polygamma(n, x), r[2], tol, f"polygamma({n}, {x})");
    }
    // psi^(n)(x + 1) = psi^(n)(x) + (-1)^n n! / x^(n+1).
    for n in [1u32, 2u32, 3u32, 6u32] {
        for x in [0.3, 2.5, 11.0] {
            let f = pkg::gamma(n as f64 + 1.0) / x.pow(n as f64 + 1.0);
            let want = pkg::polygamma(n, x) + if n % 2u32 == 0u32 { f } else { -f };
            close(pkg::polygamma(n, x + 1.0), want, 4e-15 * want.abs().max(f), f"recurrence {n} at {x}");
        }
    }
    // Reflection for n = 1 across 0: psi'(1 - z) + psi'(z) = pi^2 / sin^2(pi z).
    for x in [0.25, 0.6, 0.9] {
        let s = pkg::sinpi(x);
        rel(pkg::polygamma(1, x - 1.0) + pkg::polygamma(1, 2.0 - x), 9.869604401089358 / (s * s), 1e-14, f"reflection at {x - 1.0}");
    }
    expect(pkg::polygamma(0, 1.0) == pkg::digamma(1.0), "n = 0");
    expect(pkg::polygamma(2, -1.0) != pkg::polygamma(2, -1.0) && pkg::polygamma(3, 0.0) == f64::INFINITY, "poles");
    expect(pkg::polygamma(300, 0.5) == f64::NEG_INFINITY && pkg::polygamma(301, 0.5) == f64::INFINITY && pkg::polygamma(2, f64::INFINITY) == 0.0, "limits");
}
