const NAMES: [str; 355] = ["sin", "sin", "sin", "sin", "sin", "sin", "sin", "sin", "sin", "sin", "sin", "sin", "sin", "sin", "sin", "sin", "sin", "sin", "sin", "sin", "cos", "cos", "cos", "cos", "cos", "cos", "cos", "cos", "cos", "cos", "cos", "cos", "cos", "cos", "cos", "cos", "cos", "cos", "cos", "cos", "tan", "tan", "tan", "tan", "tan", "tan", "tan", "tan", "tan", "tan", "tan", "tan", "tan", "tan", "tan", "tan", "tan", "tan", "tan", "tan", "sinh", "sinh", "sinh", "sinh", "sinh", "sinh", "sinh", "sinh", "sinh", "sinh", "sinh", "sinh", "sinh", "sinh", "sinh", "sinh", "sinh", "sinh", "sinh", "sinh", "cosh", "cosh", "cosh", "cosh", "cosh", "cosh", "cosh", "cosh", "cosh", "cosh", "cosh", "cosh", "cosh", "cosh", "cosh", "cosh", "cosh", "cosh", "cosh", "cosh", "tanh", "tanh", "tanh", "tanh", "tanh", "tanh", "tanh", "tanh", "tanh", "tanh", "tanh", "tanh", "tanh", "tanh", "tanh", "tanh", "tanh", "tanh", "tanh", "tanh", "asin", "asin", "asin", "asin", "asin", "asin", "asin", "asin", "asin", "asin", "asin", "asin", "asin", "asin", "asin", "asin", "asin", "asin", "asin", "asin", "asin", "asin", "acos", "acos", "acos", "acos", "acos", "acos", "acos", "acos", "acos", "acos", "acos", "acos", "acos", "acos", "acos", "acos", "acos", "acos", "acos", "acos", "acos", "acos", "atan", "atan", "atan", "atan", "atan", "atan", "atan", "atan", "atan", "atan", "atan", "atan", "atan", "atan", "atan", "atan", "atan", "atan", "atan", "atan", "atan", "atan", "asinh", "asinh", "asinh", "asinh", "asinh", "asinh", "asinh", "asinh", "asinh", "asinh", "asinh", "asinh", "asinh", "asinh", "asinh", "asinh", "asinh", "asinh", "asinh", "asinh", "asinh", "asinh", "acosh", "acosh", "acosh", "acosh", "acosh", "acosh", "acosh", "acosh", "acosh", "acosh", "acosh", "acosh", "acosh", "acosh", "acosh", "acosh", "acosh", "acosh", "acosh", "acosh", "acosh", "acosh", "atanh", "atanh", "atanh", "atanh", "atanh", "atanh", "atanh", "atanh", "atanh", "atanh", "atanh", "atanh", "atanh", "atanh", "atanh", "atanh", "atanh", "atanh", "atanh", "atanh", "atanh", "log10", "log10", "log10", "log10", "log10", "log10", "log10", "log10", "log10", "log10", "log10", "log10", "log10", "log10", "log10", "log10", "log10", "log10", "log10", "log10", "log10", "log10", "expm1", "expm1", "expm1", "expm1", "expm1", "expm1", "expm1", "expm1", "expm1", "expm1", "expm1", "expm1", "expm1", "expm1", "expm1", "expm1", "expm1", "expm1", "expm1", "expm1", "ln1p", "ln1p", "ln1p", "ln1p", "ln1p", "ln1p", "ln1p", "ln1p", "ln1p", "ln1p", "ln1p", "ln1p", "ln1p", "ln1p", "ln1p", "ln1p", "ln1p", "ln1p", "ln1p", "ln1p", "cbrt", "cbrt", "cbrt", "cbrt", "cbrt", "cbrt", "cbrt", "cbrt", "cbrt", "cbrt", "cbrt", "cbrt", "cbrt", "cbrt", "cbrt", "cbrt", "cbrt", "cbrt", "cbrt", "cbrt", "log2", "log2", "log2", "log2", "log2", "log2", "log2", "log2", "log2", "log2", "log2", "log2", "log2", "log2", "log2", "log2", "log2", "log2", "log2", "log2", "log2", "log2"];

fn eval(name: str, z: Complex<f64>) -> Complex<f64> {
    match name {
        "sin" => z.sin(),
        "cos" => z.cos(),
        "tan" => z.tan(),
        "sinh" => z.sinh(),
        "cosh" => z.cosh(),
        "tanh" => z.tanh(),
        "asin" => z.asin(),
        "acos" => z.acos(),
        "atan" => z.atan(),
        "asinh" => z.asinh(),
        "acosh" => z.acosh(),
        "atanh" => z.atanh(),
        "log10" => z.log10(),
        "log2" => z.log2(),
        "cbrt" => z.cbrt(),
        "expm1" => z.expm1(),
        _ => z.ln1p(),
    }
}

// Each part within 8 ulps of the larger part's magnitude, and the sign
// of a zero part kept.
fn part_ok(got: f64, want: f64, scale: f64) -> bool {
    if want == 0.0 && got == 0.0 { return got.is_sign_negative() == want.is_sign_negative(); }
    (got - want).abs() <= 8.0 * 2.220446049250313e-16 * scale.max(f64::MIN_POSITIVE)
}

#[test]
fn against_cmath() {
    for i in 0..POINTS.len() {
        let p = POINTS[i];
        let z = Complex::new(p[0], p[1]);
        let w = eval(NAMES[i], z);
        let scale = p[2].abs().max(p[3].abs());
        expect(part_ok(w.re, p[2], scale) && part_ok(w.im, p[3], scale), f"{NAMES[i]}({z}) = {w}, want {p[2]} + {p[3]}i");
    }
}

#[test]
fn round_trips() {
    let zs = [0.3 + 0.4i, -1.2 + 0.7i, 1.1 - 1.3i, -0.1 - 0.9i, 0.0 + 0.5i];
    for z in zs {
        expect(z.sin().asin().is_close(z), f"asin(sin {z})");
        expect(z.tan().atan().is_close(z), f"atan(tan {z})");
        expect(z.sinh().asinh().is_close(z), f"asinh(sinh {z})");
        expect(z.tanh().atanh().is_close(z), f"atanh(tanh {z})");
        expect(z.cbrt().powi(3).is_close(z), f"cbrt({z})^3");
        expect(z.expm1().ln1p().is_close(z), f"ln1p(expm1 {z})");
        let s = z.sin();
        let c = z.cos();
        expect((s * s + c * c).is_close(1.0 + 0.0i), f"sin^2 + cos^2 at {z}");
    }
}

#[test]
fn cuts_and_limits() {
    // The side of a cut follows the sign of the zero part.
    expect(Complex::new(2.0, 0.0).acos().im < 0.0 && Complex::new(2.0, -0.0).acos().im > 0.0, "acos cut");
    expect(Complex::new(0.0, 2.0).atan().re > 0.0 && Complex::new(-0.0, 2.0).atan().re < 0.0, "atan cut");
    expect(Complex::new(-2.0, 0.0).acosh().im > 0.0 && Complex::new(-2.0, -0.0).acosh().im < 0.0, "acosh cut");
    // Kahan's tanh: no overflow far out.
    let t = Complex::new(800.0, 1.0).tanh();
    expect(t.re == 1.0 && t.im == 0.0, f"tanh(800 + i) = {t}");
    expect(Complex::new(1.0, 0.0).atanh().re == f64::INFINITY, "atanh(1)");
    let inf = Complex::new(f64::INFINITY, 0.0).sinh();
    expect(inf.re == f64::INFINITY && inf.im == 0.0, f"sinh(inf) = {inf}");
    // Tiny arguments keep their digits.
    let small = 1e-20 + 2e-20i;
    expect(small.expm1().is_close(small) && small.ln1p().is_close(small), "expm1, ln1p near 0");
    expect(small.asin().is_close(small) && small.atanh().is_close(small), "asin, atanh near 0");
}

#[test]
fn single_precision() {
    let z = Complex { re: 0.5f32, im: -0.25f32 };
    let w = Complex::new(0.5, -0.25).sin();
    let s = z.sin();
    expect((s.re as f64 - w.re).abs() < 1e-7 && (s.im as f64 - w.im).abs() < 1e-7, f"f32 sin {s}");
    expect(z.asin().sin().is_close(z), "f32 round trip");
}
