// The gamma function family of a complex argument and the complex zeta
// function against mpmath (40 digits: loggamma, gamma, digamma, rgamma,
// zeta), plus reflection and recurrence.

use pkg::tests::suite::{close, expect, rel};
use core::num::Complex;

const CLGAMMA: [[f64; 4]; 18] = [
    [1.0, 1.0, -0.6509231993018564, -0.3016403204675332],
    [0.5, 0.0, 0.5723649429247001, 0.0],
    [1.1, 0.05, -0.0516628914717815, -0.021149007244415596],
    [2.1, -0.1, 0.04240520033440983, -0.04859334282511769],
    [0.05, 0.02, 2.894362762938202, -0.39046046658337363],
    [-0.5, 0.0, 1.2655121234846454, -3.141592653589793],
    [-2.5, 0.5, -0.9350856212982774, -8.87096288524746],
    [-10.3, 0.1, -14.52945818853887, -34.10199875129234],
    [-7.9, -3.0, -17.45371828005289, 19.941641785779346],
    [3.0, 6.9, -5.040023054269508, 9.916353573551374],
    [6.9, 3.0, 5.714505609156715, 5.674683388993795],
    [7.1, 0.0, 6.7672934793847705, 0.0],
    [10.0, 20.0, -1.702980443956511, 52.660660425584716],
    [-100.5, 8.0, -389.0240637125839, -280.37151191046405],
    [0.0, 1.0, -0.6509231993018564, -1.8724366472624299],
    [1000.0, 1000.0, 5466.222521629902, 7039.334291911194],
    [-0.5, -6.0, -10.301059118215049, -3.1035750547750314],
    [4.5, -0.0001, 2.4537365695988167, -0.00013888709264621237],
];
const CGAMMA: [[f64; 4]; 8] = [
    [1.0, 1.0, 0.49801566811835607, -0.15494982830181067],
    [0.5, 0.5, 0.8181639995417473, -0.7633138287139826],
    [-0.5, 0.5, -1.58147782825573, -0.05485017082776478],
    [3.0, 4.0, 0.0052255384713692146, -0.1725470792943002],
    [-3.3, -0.2, 0.2697575787746625, -0.20598012599744114],
    [10.0, 1.0, -217255.64361963255, 267132.03414680116],
    [0.0, 2.0, 0.00990244008092749, -0.07595200133501807],
    [25.0, -10.0, 5.699868950101422e+22, -6.3104019148274615e+22],
];
const CDIGAMMA: [[f64; 4]; 9] = [
    [1.0, 1.0, 0.09465032062247698, 1.0766740474685812],
    [0.5, 3.0, 1.093886531678844, 1.5707963063355506],
    [-0.5, 0.5, 0.1318926373545227, 2.4406595199775145],
    [-5.5, 2.0, 1.845271764497077, 2.8204408680025947],
    [12.0, -1.0, 2.4464211487936174, -0.08668450382193077],
    [0.0, 0.1, -0.5652977902171986, 10.163421157465086],
    [1.4616321449683622, 1e-06, 4.426707563282109e-13, 9.676722454473626e-07],
    [50.0, 50.0, 4.253596595374785, 0.7904148300640832],
    [-30.2, -25.0, 3.6786208332263777, -2.458199457873765],
];
const RGAMMA: [[f64; 2]; 8] = [
    [-170.5, -3.018649650835054e+307],
    [-3.5, 3.7024941420321507],
    [-0.5, -0.28209479177387814],
    [0.1, 0.1051137006111778],
    [1.5, 1.1283791670955126],
    [10.0, 2.7557319223985893e-06],
    [171.5, 1.054477740057499e-308],
    [200.0, 0.0],
];
const CZETA: [[f64; 4]; 7] = [
    [0.5, 1.0, 0.14393642707718907, -0.722099743531673],
    [2.0, 3.0, 0.7980219851462758, -0.1137443080529385],
    [-1.5, 2.0, 0.12424726557777474, -0.015707749528273203],
    [0.5, 30.0, -0.1206422875900437, -0.5836912147637063],
    [3.0, -0.5, 1.1739287246387469, 0.09173026711347945],
    [1.0, 1e-08, 0.5772156649015329, -100000000.0],
    [-10.0, 1.0, -0.013025747660385953, -0.02301270240690352],
];

/// Each part within `tol |want| + abs`.
fn crel(got: Complex<f64>, re: f64, im: f64, tol: f64, abs: f64, what: str) {
    let m = re.hypot(im);
    close(got.re, re, tol * m + abs, f"{what} re");
    close(got.im, im, tol * m + abs, f"{what} im");
}

#[test]
fn log_gamma() {
    for r in CLGAMMA { crel(pkg::clgamma(Complex::new(r[0], r[1])), r[2], r[3], 1e-15, 5e-15, f"loggamma({r[0]}, {r[1]})"); }
    // ln Gamma(z + 1) = ln Gamma(z) + ln z off the negative axis.
    for z in [0.5 + 0.5i, 3.0 - 2.0i, 0.1 + 6.0i, 20.0 + 1.0i] {
        let d = pkg::clgamma(z + 1.0) - pkg::clgamma(z) - z.ln();
        close(d.abs(), 0.0, 4e-15 * pkg::clgamma(z).abs().max(1.0), f"recurrence at {z}");
    }
    expect(pkg::clgamma(Complex::new(-2.0, 0.0)).is_nan() && pkg::clgamma(Complex::new(f64::NAN, 1.0)).is_nan(), "poles");
    expect(pkg::clgamma(Complex::new(2.0, 0.0)).re == 0.0, "zero at 2");
}

#[test]
fn gamma_values() {
    for r in CGAMMA {
        // exp carries the absolute error of ln Gamma, about 5e-15 within 7
        // of 0 and |ln Gamma| eps past it.
        let tol = 5e-15 + 4e-16 * pkg::clgamma(Complex::new(r[0], r[1])).abs();
        crel(pkg::cgamma(Complex::new(r[0], r[1])), r[2], r[3], tol, 0.0, f"gamma({r[0]}, {r[1]})");
    }
    // Gamma(z) Gamma(1 - z) = pi / sin(pi z).
    for z in [0.3 + 0.4i, -1.7 + 0.2i, 2.5 - 1.5i] {
        let p = pkg::cgamma(z) * pkg::cgamma(1.0 - z);
        let pi = 3.141592653589793;
        let s = Complex::new(pkg::sinpi(z.re) * (pi * z.im).cosh(), pkg::cospi(z.re) * (pi * z.im).sinh());
        let want = pi / s;
        close((p - want).abs(), 0.0, 1e-14 * want.abs(), f"reflection at {z}");
    }
    for r in RGAMMA { rel(pkg::rgamma(r[0]), r[1], 1e-15, f"rgamma({r[0]})"); }
    expect(pkg::rgamma(-4.0) == 0.0 && pkg::rgamma(0.0) == 0.0, "rgamma zeros");
    let c = pkg::crgamma(Complex::new(-1.0, 0.0));
    expect(c.re == 0.0 && c.im == 0.0, "crgamma zero");
    let d = pkg::crgamma(2.0 + 1.0i) * pkg::cgamma(2.0 + 1.0i);
    close((d - 1.0).abs(), 0.0, 4e-15, "crgamma Gamma = 1");
}

#[test]
fn digamma_values() {
    for r in CDIGAMMA { crel(pkg::cdigamma(Complex::new(r[0], r[1])), r[2], r[3], 2e-15, 4e-16, f"digamma({r[0]}, {r[1]})"); }
    // psi(z + 1) = psi(z) + 1 / z.
    for z in [0.5 + 0.5i, -3.2 + 1.0i, 15.0 - 4.0i] {
        let d = pkg::cdigamma(z + 1.0) - pkg::cdigamma(z) - 1.0 / z;
        close(d.abs(), 0.0, 4e-15 * pkg::cdigamma(z).abs().max(1.0), f"recurrence at {z}");
    }
    expect(pkg::cdigamma(Complex::new(1.0, 0.0)).re == pkg::digamma(1.0), "real axis");
}

#[test]
fn complex_zeta() {
    for r in CZETA { crel(pkg::czeta(Complex::new(r[0], r[1])), r[2], r[3], 2e-15, 1e-14, f"zeta({r[0]}, {r[1]})"); }
    // The first zero on the critical line.
    expect(pkg::czeta(0.5 + 14.134725141734693i).abs() < 1e-14, "zero");
    expect(pkg::czeta(Complex::new(2.0, 0.0)).re == pkg::zeta(2.0), "real axis");
}
