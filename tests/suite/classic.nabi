#[test]
fn lgamma_values() {
    for r in LGAMMA {
        let (x, want) = (r[0], r[1]);
        let got = pkg::lgamma(x);
        if x > 0.0 { rel(got, want, 5e-16, f"lgamma({x})"); } else { close(got, want, 4e-15 * want.abs().max(1.0), f"lgamma({x})"); }
    }
    expect(pkg::lgamma(0.0) == f64::INFINITY && pkg::lgamma(-3.0) == f64::INFINITY, "poles");
    expect(pkg::lgamma(1.0) == 0.0 && pkg::lgamma(2.0) == 0.0, "zeros");
    expect(pkg::lgamma(f64::NAN) != pkg::lgamma(f64::NAN), "nan");
}

#[test]
fn gamma_values() {
    for r in GAMMA {
        let tol = if r[0] < 0.0 { 2e-15 } else { 1e-15 };
        rel(pkg::gamma(r[0]), r[1], tol, f"gamma({r[0]})");
    }
    for n in 1..24 {
        let f = 1.0;
        for k in 1..n { f *= k as f64; }
        expect(pkg::gamma(n as f64) == f, f"gamma({n}) exact");
    }
    expect(pkg::gamma(-2.0) != pkg::gamma(-2.0), "pole is NaN");
    expect(pkg::gamma(172.0) == f64::INFINITY, "overflow");
    // Gamma(x + 1) = x Gamma(x).
    for x in [0.3, 1.7, 4.2, 11.9, 40.4, -0.6, -3.3] {
        rel(pkg::gamma(x + 1.0), x * pkg::gamma(x), 4e-15, f"recurrence at {x}");
    }
    // Reflection: Gamma(x) Gamma(1 - x) = pi / sin(pi x).
    for x in [0.1, 0.25, 0.7] {
        rel(pkg::gamma(x) * pkg::gamma(1.0 - x), 3.141592653589793 / (3.141592653589793 * x).sin(), 4e-15, f"reflection at {x}");
    }
}

#[test]
fn digamma_values() {
    for r in DIGAMMA {
        let (x, want) = (r[0], r[1]);
        let got = pkg::digamma(x);
        if x > 0.0 { rel(got, want, 2e-15, f"digamma({x})"); } else { close(got, want, 1e-14 * want.abs().max(1.0), f"digamma({x})"); }
    }
    for r in TRIGAMMA { rel(pkg::trigamma(r[0]), r[1], 2e-15, f"trigamma({r[0]})"); }
}

#[test]
fn erf_values() {
    for r in ERF {
        rel(pkg::erf(r[0]), r[1], 5e-16, f"erf({r[0]})");
        rel(pkg::erfc(r[0]), r[2], 6e-16, f"erfc({r[0]})");
    }
    for x in [0.1, 0.8, 2.2, 6.0] {
        expect(pkg::erf(-x) == -pkg::erf(x), f"erf odd at {x}");
        close(pkg::erf(x) + pkg::erfc(x), 1.0, 2.0 * pkg::tests::suite::EPS, f"erf + erfc at {x}");
    }
    // erfc(27) = 5.2e-319 is subnormal; erfc(28) underflows.
    expect(pkg::erfc(27.0) > 0.0 && pkg::erfc(28.0) == 0.0 && pkg::erfc(-28.0) == 2.0, "erfc limits");
    for r in NDTR { rel(pkg::ndtr(r[0]), r[1], 6e-16, f"ndtr({r[0]})"); }
}

#[test]
fn quantile_functions() {
    for r in NDTRI { rel(pkg::ndtri(r[0]), r[1], 6e-16, f"ndtri({r[0]})"); }
    expect(pkg::ndtri(0.0) == f64::NEG_INFINITY && pkg::ndtri(1.0) == f64::INFINITY, "ndtri ends");
    expect(pkg::ndtri(1.5) != pkg::ndtri(1.5), "ndtri outside");
    for r in ERFINV {
        rel(pkg::erfinv(r[0]), r[1], 6e-16, f"erfinv({r[0]})");
        expect(pkg::erfinv(-r[0]) == -pkg::erfinv(r[0]), "erfinv odd");
    }
    for q in [1e-300, 1e-100, 1e-10, 0.3, 1.0, 1.7] {
        // erfc changes by 2x relative per unit of x: one ulp of x is 2 x^2
        // eps of erfc (8e-14 at 1e-300).
        let x = pkg::erfcinv(q);
        rel(pkg::erfc(x), q, 4.0 * x * x * 2.3e-16 + 4e-16, f"erfc(erfcinv({q}))");
    }
    // ndtr(ndtri(p)) = p across the tails.
    for p in [1e-280, 1e-30, 1e-8, 0.003, 0.2, 0.5, 0.77, 0.99] {
        // Phi changes by |x| relative per unit of x; one ulp of x costs x^2 eps.
        let x = pkg::ndtri(p);
        rel(pkg::ndtr(x), p, 4e-16 * (1.0 + x * x), f"ndtr(ndtri({p}))");
    }
}

#[test]
fn incomplete_gamma() {
    for r in GAMMAINC {
        let (a, x) = (r[0], r[1]);
        // P and Q change by about a |ln x - psi(a)| relative per unit of
        // relative change in a, so large a costs digits.
        let tol = if a >= 10.0 { 1e-13 } else { 4e-15 };
        rel(pkg::gammainc(a, x), r[2], tol, f"P({a}, {x})");
        rel(pkg::gammaincc(a, x), r[3], tol, f"Q({a}, {x})");
    }
    expect(pkg::gammainc(1.0, 0.0) == 0.0 && pkg::gammaincc(1.0, 0.0) == 1.0, "x = 0");
    expect(pkg::gammainc(0.0, 1.0) != pkg::gammainc(0.0, 1.0), "a = 0 is NaN");
    expect(pkg::gammainc(2.0, f64::INFINITY) == 1.0, "x = inf");
    // P(1, x) = 1 - e^-x and Q(n, x) = e^-x sum x^k / k!.
    for x in [0.01, 0.5, 4.0, 30.0] {
        rel(pkg::gammaincc(1.0, x), (-x).exp(), 2e-15, f"Q(1, {x})");
        rel(pkg::gammaincc(3.0, x), (-x).exp() * (1.0 + x + x * x / 2.0), 4e-15, f"Q(3, {x})");
    }
    for a in [0.05, 0.7, 3.0, 25.0, 400.0] {
        for p in [1e-12, 0.01, 0.4, 0.9, 0.999999] {
            let x = pkg::gammaincinv(a, p);
            rel(pkg::gammainc(a, x), p, 1e-13, f"P(a, Pinv) at a = {a}, p = {p}");
            let y = pkg::gammainccinv(a, p);
            rel(pkg::gammaincc(a, y), p, 1e-13, f"Q(a, Qinv) at a = {a}, q = {p}");
        }
    }
}

#[test]
fn incomplete_beta() {
    for r in BETAINC {
        let (a, b, x) = (r[0], r[1], r[2]);
        let tol = if a >= 1e3 || b >= 1e3 { 1e-13 } else { 2e-14 };
        rel(pkg::betainc(a, b, x), r[3], tol, f"I({x}; {a}, {b})");
        rel(pkg::betaincc(a, b, x), r[4], tol, f"1 - I({x}; {a}, {b})");
    }
    for r in LBETA { rel(pkg::lbeta(r[0], r[1]), r[2], 1e-15, f"lbeta({r[0]}, {r[1]})"); }
    rel(pkg::beta(2.0, 3.0), 1.0 / 12.0, 1e-16, "beta(2, 3)");
    // I_x(a, b) = 1 - I_(1-x)(b, a), I_x(1, 1) = x, I_x(a, 1) = x^a.
    for x in [0.1, 0.5, 0.875] {
        close(pkg::betainc(2.5, 4.0, x), pkg::betaincc(4.0, 2.5, 1.0 - x), 2e-16, f"symmetry at {x}");
        close(pkg::betainc(1.0, 1.0, x), x, 2e-16, "uniform");
        rel(pkg::betainc(3.0, 1.0, x), x * x * x, 2e-15, "power");
    }
    for ab in [(0.2, 0.3), (2.0, 5.0), (40.0, 9.0), (500.0, 700.0)] {
        let (a, b) = ab;
        for p in [1e-10, 0.05, 0.5, 0.95, 0.9999] {
            // Within 1e-12, or the best double: p between I at its neighbours.
            let x = pkg::betaincinv(a, b, p);
            let ok = (pkg::betainc(a, b, x) - p).abs() <= 1e-12 * p
                || (pkg::betainc(a, b, x.next_down()) <= p && p <= pkg::betainc(a, b, x.next_up()));
            expect(ok, f"I(Iinv) at {a}, {b}, {p}: x = {x}, I = {pkg::betainc(a, b, x)}");
        }
    }
}
