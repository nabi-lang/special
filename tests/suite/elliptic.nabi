#[test]
fn carlson_values() {
    for r in RF { rel(pkg::elliprf(r[0], r[1], r[2]), r[3], 6e-16, f"R_F({r[0]}, {r[1]}, {r[2]})"); }
    for r in RD { rel(pkg::elliprd(r[0], r[1], r[2]), r[3], 1e-15, f"R_D({r[0]}, {r[1]}, {r[2]})"); }
    for r in RJ { rel(pkg::elliprj(r[0], r[1], r[2], r[3]), r[4], 2e-15, f"R_J({r[0]}, {r[1]}, {r[2]}, {r[3]})"); }
    for r in RC { rel(pkg::elliprc(r[0], r[1]), r[2], 6e-16, f"R_C({r[0]}, {r[1]})"); }
    for r in RG { rel(pkg::elliprg(r[0], r[1], r[2]), r[3], 1e-15, f"R_G({r[0]}, {r[1]}, {r[2]})"); }
    // Symmetry and homogeneity: R_F(l x, l y, l z) = R_F(x, y, z) / sqrt(l).
    rel(pkg::elliprf(3.0, 1.0, 2.0), pkg::elliprf(1.0, 2.0, 3.0), 4e-16, "R_F symmetric");
    rel(pkg::elliprf(4.0, 8.0, 12.0), 0.5 * pkg::elliprf(1.0, 2.0, 3.0), 4e-16, "R_F homogeneous");
    rel(pkg::elliprj(2.0, 3.0, 1.5, 1.5), pkg::elliprd(2.0, 3.0, 1.5), 2e-15, "R_J = R_D");
    for r in RJPV { rel(pkg::elliprj(r[0], r[1], r[2], r[3]), r[4], 2e-14, f"R_J({r[0]}, {r[1]}, {r[2]}, {r[3]}) principal value"); }
    expect(pkg::elliprf(0.0, 0.0, 1.0) == f64::INFINITY && pkg::elliprd(0.0, 0.0, 1.0) == f64::INFINITY, "two zeros");
    expect(pkg::elliprf(-1.0, 1.0, 1.0) != pkg::elliprf(-1.0, 1.0, 1.0), "negative is NaN");
    expect(pkg::elliprc(1.0, 0.0) != pkg::elliprc(1.0, 0.0) && pkg::elliprd(1.0, 1.0, 0.0) != pkg::elliprd(1.0, 1.0, 0.0), "domain");
    expect(pkg::elliprf(f64::NAN, 1.0, 1.0) != pkg::elliprf(f64::NAN, 1.0, 1.0), "nan");
}

#[test]
fn complete_values() {
    for r in KE {
        rel(pkg::ellipk(r[0]), r[1], 4e-16, f"K({r[0]})");
        rel(pkg::ellipe(r[0]), r[2], 6e-16, f"E({r[0]})");
    }
    for r in KM1 { rel(pkg::ellipkm1(r[0]), r[1], 4e-16, f"K(1 - {r[0]})"); }
    expect(pkg::ellipk(1.0) == f64::INFINITY && pkg::ellipe(1.0) == 1.0, "m = 1");
    expect(pkg::ellipk(1.5) != pkg::ellipk(1.5) && pkg::ellipe(2.0) != pkg::ellipe(2.0), "m > 1 is NaN");
    expect(pkg::ellipk(f64::NEG_INFINITY) == 0.0 && pkg::ellipe(f64::NEG_INFINITY) == f64::INFINITY, "m = -inf");
    // Legendre's relation E K' + E' K - K K' = pi / 2.
    for m in [0.01, 0.2, 0.5, 0.77, 0.999] {
        let (k, e) = (pkg::ellipk(m), pkg::ellipe(m));
        let (k1, e1) = (pkg::ellipk(1.0 - m), pkg::ellipe(1.0 - m));
        close(e * k1 + e1 * k - k * k1, 1.5707963267948966, 4e-15, f"Legendre relation at {m}");
    }
}

#[test]
fn incomplete_values() {
    for r in INC {
        rel(pkg::ellipkinc(r[0], r[1]), r[2], 1e-15, f"F({r[0]} | {r[1]})");
        rel(pkg::ellipeinc(r[0], r[1]), r[3], 1e-15, f"E({r[0]} | {r[1]})");
    }
    for r in PI { rel(pkg::ellippi(r[0], r[1]), r[2], 2e-15, f"Pi({r[0]} | {r[1]})"); }
    for r in PIPV { rel(pkg::ellippi(r[0], r[1]), r[2], 2e-14, f"Pi({r[0]} | {r[1]}) principal value"); }
    for r in PIINC { rel(pkg::ellippiinc(r[0], r[1], r[2]), r[3], 2e-15, f"Pi({r[0]}; {r[1]} | {r[2]})"); }
    // Odd in phi, complete at pi / 2, 2K per half period.
    for m in [0.1, 0.6, 0.95] {
        expect(pkg::ellipkinc(-0.7, m) == -pkg::ellipkinc(0.7, m), "F odd");
        rel(pkg::ellipkinc(1.5707963267948966, m), pkg::ellipk(m), 4e-16, f"F(pi/2 | {m}) = K");
        rel(pkg::ellipeinc(1.5707963267948966, m), pkg::ellipe(m), 4e-16, f"E(pi/2 | {m}) = E");
        rel(pkg::ellipeinc(2.0 + 3.141592653589793, m), pkg::ellipeinc(2.0, m) + 2.0 * pkg::ellipe(m), 1e-15, "E period");
        rel(pkg::ellippiinc(0.4, 1.5707963267948966, m), pkg::ellippi(0.4, m), 1e-15, "Pi(pi/2) = Pi");
    }
    expect(pkg::ellipkinc(1.0, 0.0) == 1.0 && pkg::ellipeinc(1.0, 0.0) == 1.0, "m = 0");
    expect(pkg::ellipkinc(1.5707963267948966, 1.0) > 30.0 && pkg::ellipkinc(2.0, 1.0) == f64::INFINITY, "m = 1");
    expect(pkg::ellipkinc(1.0, 3.0) != pkg::ellipkinc(1.0, 3.0), "m sin^2 > 1 is NaN");
    expect(pkg::ellippi(1.0, 0.5) == f64::INFINITY, "n = 1");
}

#[test]
fn jacobi_values() {
    for r in JAC {
        let (sn, cn, dn, _) = pkg::ellipj(r[0], r[1]);
        close(sn, r[2], 6e-16, f"sn({r[0]} | {r[1]})");
        close(cn, r[3], 6e-16, f"cn({r[0]} | {r[1]})");
        close(dn, r[4], 6e-16, f"dn({r[0]} | {r[1]})");
    }
    for r in JAC_OUT {
        let (sn, cn, dn, _) = pkg::ellipj(r[0], r[1]);
        close(sn, r[2], 1e-15, f"sn({r[0]} | {r[1]})");
        close(cn, r[3], 1e-15, f"cn({r[0]} | {r[1]})");
        close(dn, r[4], 1e-15, f"dn({r[0]} | {r[1]})");
    }
    for r in AM {
        let (_, _, _, am) = pkg::ellipj(r[0], r[1]);
        close(am, r[2], 4e-15, f"am({r[0]} | {r[1]})");
    }
    for m in [0.0, 1e-11, 0.2, 0.5, 0.9, 0.999999, 1.0, -4.0, 3.0] {
        for u in [-6.0, -0.4, 0.3, 1.7, 9.0] {
            let (sn, cn, dn, _) = pkg::ellipj(u, m);
            close(sn * sn + cn * cn, 1.0, 4e-16, f"sn^2 + cn^2 at {u}, {m}");
            close(dn * dn + m * sn * sn, 1.0, 1e-15 * m.abs().max(1.0), f"dn^2 + m sn^2 at {u}, {m}");
        }
    }
    // Addition: sn(u + v) = (sn u cn v dn v + sn v cn u dn u) / (1 - m sn^2 u sn^2 v).
    let m = 0.6;
    let (u, v) = (0.7, 1.9);
    let (su, cu, du, _) = pkg::ellipj(u, m);
    let (sv, cv, dv, _) = pkg::ellipj(v, m);
    let (s, _, _, _) = pkg::ellipj(u + v, m);
    close(s, (su * cv * dv + sv * cu * du) / (1.0 - m * su * su * sv * sv), 1e-15, "addition theorem");
    // Quarter period: sn(K) = 1, cn(K) = 0.
    let (sk, ck, dk, ak) = pkg::ellipj(pkg::ellipk(m), m);
    close(sk, 1.0, 1e-15, "sn(K)");
    close(ck, 0.0, 1e-15, "cn(K)");
    close(dk, (1.0 - m).sqrt(), 1e-15, "dn(K)");
    close(ak, 1.5707963267948966, 1e-15, "am(K)");
    let (n0, _, _, _) = pkg::ellipj(f64::NAN, 0.5);
    expect(n0 != n0, "nan");
}
