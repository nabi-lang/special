// Elliptic integrals and Jacobi's functions against mpmath (40 digits:
// elliprf, elliprd, elliprj, elliprc, elliprg, ellipk, ellipe, ellipf,
// ellipe(phi, m), ellippi and ellipfun; the principal values of Pi for
// n > 1 as the real part of mpmath's complex value, the amplitude by
// findroot on ellipf), plus Legendre's relation, the Pythagorean
// identities of sn, cn, dn and the addition theorem.

use pkg::tests::suite::{close, expect, rel};

