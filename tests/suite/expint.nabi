#[test]
fn exponential_integrals() {
    for r in E1 { rel(pkg::e1(r[0]), r[1], 6e-16, f"e1({r[0]})"); }
    for r in EI { rel(pkg::ei(r[0]), r[1], 1e-15, f"ei({r[0]})"); }
    for r in EXPN { rel(pkg::expn(r[0] as u32, r[1]), r[2], 1e-15, f"expn({r[0]}, {r[1]})"); }
    expect(pkg::e1(0.0) == f64::INFINITY && pkg::e1(-1.0) != pkg::e1(-1.0), "e1 ends");
    expect(pkg::ei(0.0) == f64::NEG_INFINITY && pkg::ei(720.0) == f64::INFINITY && pkg::e1(800.0) == 0.0, "ei ends");
    expect(pkg::expn(0, 2.0) == (-2.0).exp() / 2.0 && pkg::expn(1, 0.0) == f64::INFINITY && pkg::expn(4, 0.0) == 1.0 / 3.0, "expn ends");
    // n E_(n+1)(x) = e^-x - x E_n(x).
    for n in [1u32, 2u32, 5u32, 30u32] {
        for x in [0.2, 1.0, 3.5, 40.0] {
            let want = (-x).exp() - x * pkg::expn(n, x);
            close(n as f64 * pkg::expn(n + 1u32, x), want, 4e-16 * ((-x).exp() + want.abs()), f"recurrence {n} at {x}");
        }
    }
    expect(pkg::expn(1, 2.5) == pkg::e1(2.5), "E_1 = e1");
}

#[test]
fn trigonometric_integrals() {
    for r in SICI {
        let (s, c) = pkg::sici(r[0]);
        rel(s, r[1], 6e-16, f"si({r[0]})");
        // Ci past 2 has absolute accuracy near its zeros.
        if r[0] > 2.0 { close(c, r[2], 2e-16 * r[2].abs() + 1.5e-15 / r[0], f"ci({r[0]})"); } else { rel(c, r[2], 6e-16, f"ci({r[0]})"); }
    }
    for r in SHICHI {
        let (s, c) = pkg::shichi(r[0]);
        rel(s, r[1], 6e-16, f"shi({r[0]})");
        rel(c, r[2], 6e-16, f"chi({r[0]})");
    }
    let (s, c) = pkg::sici(-3.0);
    expect(s == -pkg::si(3.0) && c == pkg::ci(3.0), "sici odd, real part");
    expect(pkg::sici(0.0).1 == f64::NEG_INFINITY && pkg::sici(f64::INFINITY) == (1.5707963267948966, 0.0), "sici ends");
    // Chi(x) = (Ei(x) - E1(x)) / 2 and Shi = (Ei + E1) / 2.
    for x in [0.3, 2.0, 7.0] {
        let (s, c) = pkg::shichi(x);
        rel(c, 0.5 * (pkg::ei(x) - pkg::e1(x)), 2e-15, f"chi at {x}");
        rel(s, 0.5 * (pkg::ei(x) + pkg::e1(x)), 1e-15, f"shi at {x}");
    }
}

#[test]
fn fresnel_values() {
    for r in FRESNEL {
        let (s, c) = pkg::fresnel(r[0]);
        rel(s, r[1], 5e-16, f"S({r[0]})");
        rel(c, r[2], 5e-16, f"C({r[0]})");
    }
    let (s, c) = pkg::fresnel(-2.0);
    expect((s, c) == (-pkg::fresnel(2.0).0, -pkg::fresnel(2.0).1), "odd");
    expect(pkg::fresnel(0.0) == (0.0, 0.0) && pkg::fresnel(1e300) == (0.5, 0.5), "ends");
}

#[test]
fn lambert_w() {
    for r in LAMBERTW {
        let w = pkg::lambertw(r[0], r[1] as i32);
        // Near -1/e the rounding of x itself is magnified by 1 / p.
        let p = (2.0 * (1.0 + 2.718281828459045 * r[0])).abs().sqrt();
        rel(w, r[2], 4e-16 + 4e-17 / p, f"W_{r[1]}({r[0]})");
    }
    // w e^w = x.
    for x in [-0.3, -0.01, 0.5, 7.0, 1e5, 1e200] {
        let w = pkg::lambertw(x);
        rel(w * w.exp(), x, 2e-16 * (4.0 + w.abs()), f"W_0({x}) e^W");
    }
    for x in [-0.35, -0.2, -1e-5, -1e-200] {
        let w = pkg::lambertw(x, -1);
        rel(w * w.exp(), x, 2e-16 * (4.0 + w.abs()), f"W_-1({x}) e^W");
    }
    expect(pkg::lambertw(0.0) == 0.0 && pkg::lambertw(0.0, -1) == f64::NEG_INFINITY, "zero");
    expect(pkg::lambertw(-0.4) != pkg::lambertw(-0.4) && pkg::lambertw(1.0, -1) != pkg::lambertw(1.0, -1), "off the range");
    expect(pkg::lambertw(1.0, 1) != pkg::lambertw(1.0, 1), "other branch");
    expect(pkg::lambertw(f64::INFINITY) == f64::INFINITY, "inf");
    expect(pkg::lambertw(-0.36787944117144233) == -1.0 && pkg::lambertw(-0.36787944117144233, -1) == -1.0, "branch point");
}
