/// Each part within `tol` of its own size, or of `|want|` times `floor`.
fn crel(got: Complex<f64>, re: f64, im: f64, tol: f64, floor: f64, what: str) {
    let m = re.hypot(im);
    close(got.re, re, tol * re.abs().max(floor * m), f"{what} re");
    close(got.im, im, tol * im.abs().max(floor * m), f"{what} im");
}

#[test]
fn faddeeva_values() {
    for r in WOFZ {
        let z = Complex::new(r[0], r[1]);
        // Im w for |Re z| < 0.01 and 1 < Im z < 2 loses digits to its
        // own size, not to |w|.
        let tol = if r[0].abs() < 0.01 && r[1] > 1.0 && r[1] < 2.0 { 2e-14 } else { 2e-15 };
        crel(pkg::wofz(z), r[2], r[3], tol, 1e-17, f"w({z})");
    }
    // w(-conj z) = conj w(z); w(-z) = 2 e^-z^2 - w(z).
    for z in [0.5 + 0.2i, 3.0 + 1.0i, 7.0 + 0.3i] {
        let w = pkg::wofz(z);
        let v = pkg::wofz(Complex::new(-z.re, z.im));
        expect(v.re == w.re && v.im == -w.im, f"reflection at {z}");
        let u = pkg::wofz(-z) + w;
        let e = (-(z * z)).exp() * 2.0;
        close((u - e).abs(), 0.0, 1e-15 * (e.abs() + w.abs()), f"w(-z) at {z}");
    }
    expect(pkg::wofz(Complex::new(f64::NAN, 0.0)).is_nan(), "nan");
}

#[test]
fn real_error_functions() {
    for r in ERFCX { rel(pkg::erfcx(r[0]), r[1], 6e-16, f"erfcx({r[0]})"); }
    for r in DAWSON { rel(pkg::dawson(r[0]), r[1], 5e-16, f"dawson({r[0]})"); }
    for r in ERFI { rel(pkg::erfi(r[0]), r[1], 7e-16, f"erfi({r[0]})"); }
    expect(pkg::erfcx(-27.0) == f64::INFINITY && pkg::erfcx(f64::INFINITY) == 0.0, "erfcx ends");
    expect(pkg::erfi(27.0) == f64::INFINITY && pkg::erfi(-1.0) == -pkg::erfi(1.0), "erfi ends");
    expect(pkg::dawson(-3.0) == -pkg::dawson(3.0) && pkg::dawson(0.0) == 0.0, "dawson odd");
    // erfcx(x) = e^x^2 erfc(x) where both are representable.
    for x in [0.3, 1.5, 5.0, 20.0] { rel(pkg::erfcx(x), (x * x).exp() * pkg::erfc(x), 6e-15, f"erfcx at {x}"); }
}

#[test]
fn complex_error_functions() {
    for r in CERF { crel(pkg::cerf(Complex::new(r[0], r[1])), r[2], r[3], 2e-15, 1e-16, f"erf({r[0]}, {r[1]})"); }
    for r in CERFC { crel(pkg::cerfc(Complex::new(r[0], r[1])), r[2], r[3], 2e-15, 1e-16, f"erfc({r[0]}, {r[1]})"); }
    // Im D within 0.05 of the real axis carries the cancellation of
    // D'(x) = 1 - 2x D(x).
    for r in CDAWSON { crel(pkg::cdawson(Complex::new(r[0], r[1])), r[2], r[3], if r[1].abs() < 0.05 { 1e-14 } else { 2e-15 }, 1e-16, f"dawson({r[0]}, {r[1]})"); }
    // erf(z) + erfc(z) = 1, erfi(z) = -i erf(iz), erfcx(z) = w(iz).
    for z in [0.3 + 0.1i, 1.5 - 2.0i, -2.0 + 0.5i] {
        close((pkg::cerf(z) + pkg::cerfc(z) - 1.0).abs(), 0.0, 4e-15 * pkg::cerf(z).abs().max(1.0), f"erf + erfc at {z}");
        let e = pkg::cerfi(z);
        let f = pkg::cerf(Complex::new(-z.im, z.re));
        expect(e.re == f.im && e.im == -f.re, f"erfi at {z}");
        let w = pkg::cerfcx(z);
        let v = pkg::wofz(Complex::new(-z.im, z.re));
        expect(w == v, f"erfcx at {z}");
    }
    expect(pkg::cerf(Complex::new(0.5, 0.0)).re == pkg::erf(0.5) && pkg::cerf(Complex::new(0.0, 0.5)).im == pkg::erfi(0.5), "axes");
    expect(pkg::cdawson(Complex::new(2.0, 0.0)).re == pkg::dawson(2.0), "dawson axis");
}
