/// Every row of `t` within `tol` of its scale.
fn check2(t: List<[f64; 3]>, f: fn(f64) -> f64, tol: f64, what: str) {
    for r in t {
        let g = f(r[0]);
        if !((g - r[1]).abs() <= tol * r[2]) { panic(f"check failed: {what}({r[0]}) = {g}, want {r[1]} (err {(g - r[1]).abs() / r[2]}, tol {tol})"); }
    }
}

fn check3(t: List<[f64; 4]>, f: fn(f64, f64) -> f64, tol: f64, what: str) {
    for r in t {
        let g = f(r[0], r[1]);
        let e = if r[2] == 0.0 { g.abs() } else { (g - r[2]).abs() / r[3] };
        if !(e <= tol) { panic(f"check failed: {what}({r[0]}, {r[1]}) = {g}, want {r[2]} (err {e}, tol {tol})"); }
    }
}

fn own(t: List<[f64; 2]>) -> List<[f64; 3]> {
    let o: List<[f64; 3]> = [];
    for r in t { o.push([r[0], r[1], r[1]]); }
    o
}

#[test]
fn integer_order() {
    check2(J0.to_list(), |x: f64| -> f64 { pkg::j0(x) }, 2e-15, "j0");
    check2(J1.to_list(), |x: f64| -> f64 { pkg::j1(x) }, 2e-15, "j1");
    check2(Y0.to_list(), |x: f64| -> f64 { pkg::y0(x) }, 2e-15, "y0");
    check2(Y1.to_list(), |x: f64| -> f64 { pkg::y1(x) }, 2e-15, "y1");
    check2(own(I0E.to_list()), |x: f64| -> f64 { pkg::i0e(x) }, 1e-15, "i0e");
    check2(own(I1E.to_list()), |x: f64| -> f64 { pkg::i1e(x) }, 2e-15, "i1e");
    check2(own(K0E.to_list()), |x: f64| -> f64 { pkg::k0e(x) }, 1e-15, "k0e");
    check2(own(K1E.to_list()), |x: f64| -> f64 { pkg::k1e(x) }, 1e-15, "k1e");
    check3(JN.to_list(), |n: f64, x: f64| -> f64 { pkg::jn(n as i32, x) }, 1e-14, "jn");
    check3(YN.to_list(), |n: f64, x: f64| -> f64 { pkg::yn(n as i32, x) }, 1e-14, "yn");
    // The unscaled forms agree with the scaled ones.
    for x in [0.3, 1.0, 5.0, 9.0, 40.0] {
        rel(pkg::i0(x) * (-x).exp(), pkg::i0e(x), 4e-16, f"i0 at {x}");
        rel(pkg::i1(x) * (-x).exp(), pkg::i1e(x), 4e-16, f"i1 at {x}");
        rel(pkg::k0(x) * x.exp(), pkg::k0e(x), 4e-16, f"k0 at {x}");
        rel(pkg::k1(x) * x.exp(), pkg::k1e(x), 4e-16, f"k1 at {x}");
        rel(pkg::kn(4, x) * x.exp(), pkg::kve(4.0, x), 4e-15, f"kn at {x}");
    }
}

#[test]
fn real_order() {
    check3(JV.to_list(), |v: f64, x: f64| -> f64 { pkg::jv(v, x) }, 1e-13, "jv");
    check3(YV.to_list(), |v: f64, x: f64| -> f64 { pkg::yv(v, x) }, 3e-14, "yv");
    check3(IV.to_list(), |v: f64, x: f64| -> f64 { pkg::ive(v, x) }, 2e-14, "ive");
    check3(KV.to_list(), |v: f64, x: f64| -> f64 { pkg::kve(v, x) }, 3e-14, "kve");
    for r in IV {
        if r[1] < 500.0 { rel(pkg::iv(r[0], r[1]) * (-r[1]).exp(), r[2], 3e-14, f"iv({r[0]}, {r[1]})"); }
    }
    for r in KV {
        if r[1] < 500.0 { rel(pkg::kv(r[0], r[1]) * r[1].exp(), r[2], 3e-14, f"kv({r[0]}, {r[1]})"); }
    }
    // Integer orders give the integer routines; nearby orders are close.
    expect(pkg::jv(3.0, 2.5) == pkg::jn(3, 2.5) && pkg::yv(-2.0, 2.5) == pkg::yn(2, 2.5), "integer v");
    close(pkg::jv(2.0 + 1e-9, 3.0), pkg::jn(2, 3.0), 1e-9, "jv near 2");
    close(pkg::yv(1.0 + 1e-9, 2.0), pkg::y1(2.0), 2e-9, "yv near 1");
    close(pkg::kv(1e-9, 0.7), pkg::k0(0.7), 1e-15, "kv near 0");
    close(pkg::iv(-3.0 + 1e-9, 1.3), pkg::iv(3.0, 1.3), 2e-8, "iv near -3");
    // Half orders in closed form: J_1/2 = sqrt(2 / (pi x)) sin x.
    for x in [0.01, 1.0, 7.5, 60.0, 1e4] {
        let c = (2.0 / (3.141592653589793 * x)).sqrt();
        close(pkg::jv(0.5, x), c * x.sin(), 1e-15 * c, f"J_1/2 at {x}");
        close(pkg::yv(0.5, x), -c * x.cos(), 1e-15 * c, f"Y_1/2 at {x}");
        close(pkg::jv(-0.5, x), c * x.cos(), 1e-15 * c, f"J_-1/2 at {x}");
        rel(pkg::kve(0.5, x), (3.141592653589793 / (2.0 * x)).sqrt(), 1e-15, f"K_1/2 at {x}");
    }
}

#[test]
fn wronskians() {
    // J_v+1 Y_v - J_v Y_v+1 = 2 / (pi x), I_v K_v+1 + I_v+1 K_v = 1 / x.
    for v in [0.0, 0.3, 1.0, 2.5, 7.7, 30.2] {
        for x in [0.4, 3.0, 11.0, 20.0, 100.0, 2500.0] {
            let (ja, jb, ya, yb) = (pkg::jv(v, x), pkg::jv(v + 1.0, x), pkg::yv(v, x), pkg::yv(v + 1.0, x));
            let w = jb * ya - ja * yb;
            close(w, 2.0 / (3.141592653589793 * x), 1e-14 * ((jb * ya).abs() + (ja * yb).abs()), f"J Y Wronskian at {v}, {x}");
            let wi = pkg::ive(v, x) * pkg::kve(v + 1.0, x) + pkg::ive(v + 1.0, x) * pkg::kve(v, x);
            rel(wi, 1.0 / x, 1e-14, f"I K Wronskian at {v}, {x}");
        }
    }
}

#[test]
fn recurrences_and_reflection() {
    // J_v-1 + J_v+1 = 2v / x J_v, the same for Y; K_v+1 - K_v-1 = 2v / x K_v.
    for v in [0.6, 3.3, 12.5] {
        for x in [0.9, 4.0, 33.0] {
            let s = pkg::jv(v - 1.0, x) + pkg::jv(v + 1.0, x);
            close(s, 2.0 * v / x * pkg::jv(v, x), 1e-14 * (pkg::jv(v - 1.0, x).abs() + pkg::jv(v + 1.0, x).abs()), f"J recurrence {v}, {x}");
            let t = pkg::yv(v - 1.0, x) + pkg::yv(v + 1.0, x);
            close(t, 2.0 * v / x * pkg::yv(v, x), 1e-14 * (pkg::yv(v - 1.0, x).abs() + pkg::yv(v + 1.0, x).abs()), f"Y recurrence {v}, {x}");
            rel(pkg::kv(v + 1.0, x) - pkg::kv(v - 1.0, x), 2.0 * v / x * pkg::kv(v, x), 1e-14, f"K recurrence {v}, {x}");
        }
    }
    // J_-n = (-1)^n J_n, J_n(-x) = (-1)^n J_n(x), K_-v = K_v.
    for x in [0.5, 6.0, 80.0] {
        expect(pkg::jn(-3, x) == -pkg::jn(3, x) && pkg::jn(4, -x) == pkg::jn(4, x), "jn signs");
        expect(pkg::yn(-3, x) == -pkg::yn(3, x), "yn sign");
        expect(pkg::kv(-2.3, x) == pkg::kv(2.3, x), "kv even in v");
        expect(pkg::iv(3.0, -x) == -pkg::iv(3.0, x), "iv odd n");
    }
}

#[test]
fn edges() {
    let nan = f64::NAN;
    expect(pkg::j0(nan) != pkg::j0(nan) && pkg::jv(0.5, nan) != pkg::jv(0.5, nan) && pkg::kv(nan, 1.0) != pkg::kv(nan, 1.0), "NaN");
    expect(pkg::y0(0.0) == f64::NEG_INFINITY && pkg::yv(2.5, 0.0) == f64::NEG_INFINITY && pkg::yn(3, 0.0) == f64::NEG_INFINITY, "Y at 0");
    expect(pkg::k0(0.0) == f64::INFINITY && pkg::kv(0.3, 0.0) == f64::INFINITY, "K at 0");
    expect(pkg::jv(0.0, 0.0) == 1.0 && pkg::jv(1.5, 0.0) == 0.0 && pkg::iv(0.0, 0.0) == 1.0 && pkg::iv(2.5, 0.0) == 0.0, "J, I at 0");
    expect(pkg::jv(-0.5, 0.0) == f64::INFINITY, "J_-1/2 at 0");
    expect(pkg::y0(-1.0) != pkg::y0(-1.0) && pkg::jv(0.5, -1.0) != pkg::jv(0.5, -1.0) && pkg::kv(1.0, -1.0) != pkg::kv(1.0, -1.0), "negative x");
    expect(pkg::j0(f64::INFINITY) == 0.0 && pkg::yv(0.5, f64::INFINITY) == 0.0 && pkg::k1(f64::INFINITY) == 0.0, "x = inf");
    expect(pkg::i0(800.0) == f64::INFINITY && pkg::iv(0.5, 1000.0) == f64::INFINITY && pkg::k0(800.0) == 0.0, "overflow, underflow");
    expect(pkg::i0e(1e300) > 0.0 && pkg::k0e(1e300) > 0.0, "scaled at 1e300");
    expect(pkg::jn(1000, 1.0) == 0.0 && pkg::jv(400.5, 1.0) == 0.0 && pkg::yn(400, 1.0) == f64::NEG_INFINITY, "huge order");
    // The leading terms at tiny x.
    rel(pkg::jv(2.5, 1e-150), (5e-151f64).pow(2.5) / 3.3233509704478426, 1e-14, "jv at 1e-150");
    rel(pkg::yv(0.5, 1e-200), -(2.0 / (3.141592653589793 * 1e-200)).sqrt(), 1e-14, "yv at 1e-200");
    rel(pkg::kv(0.5, 1e-200), (3.141592653589793 / 2e-200).sqrt(), 1e-14, "kv at 1e-200");
}

#[test]
fn hankel() {
    for v in [-1.5, 0.0, 0.7, 4.0] {
        for x in [0.5, 3.0, 50.0] {
            let h = pkg::hankel1(v, x);
            expect(h.re == pkg::jv(v, x) && h.im == pkg::yv(v, x), f"H1 parts at {v}, {x}");
            expect(pkg::hankel2(v, x) == h.conj(), "H2");
            let e = pkg::hankel1e(v, x);
            rel(e.abs(), h.abs(), 1e-15, f"|H1e| at {v}, {x}");
            rel(pkg::hankel2e(v, x).abs(), h.abs(), 1e-15, "|H2e|");
        }
    }
    // H1_-v = e^(i v pi) H1_v.
    let (a, b) = (pkg::hankel1(-0.3, 2.0), pkg::hankel1(0.3, 2.0));
    let (c, s) = ((0.3 * 3.141592653589793).cos(), (0.3 * 3.141592653589793).sin());
    close(a.re, c * b.re - s * b.im, 1e-15, "H1 reflection re");
    close(a.im, s * b.re + c * b.im, 1e-15, "H1 reflection im");
    expect(pkg::hankel1(1.0, -1.0).is_nan(), "x < 0");
}

#[test]
fn spherical() {
    for r in SPH {
        let n = r[0] as u32;
        let x = r[1];
        close(pkg::spherical_jn(n, x), r[2], 3e-15 * r[3], f"j_{n}({x})");
        close(pkg::spherical_yn(n, x), r[4], 3e-15 * r[5], f"y_{n}({x})");
        rel(pkg::spherical_in(n, x), r[6], 3e-15, f"i_{n}({x})");
        rel(pkg::spherical_kn(n, x), r[7], 3e-15, f"k_{n}({x})");
    }
    // The other derivative forms: f'_n = n / x f_n - f_n+1 (j, y),
    // i'_n = i_n+1 + n / x i_n, k'_n = n / x k_n - k_n+1.
    for n in [0u32, 1u32, 4u32, 15u32] {
        for x in [0.7, 5.0, 40.0] {
            let nx = n as f64 / x;
            close(pkg::spherical_jn(n, x, derivative: true), nx * pkg::spherical_jn(n, x) - pkg::spherical_jn(n + 1u32, x), 1e-15, f"j' at {n}, {x}");
            rel(pkg::spherical_yn(n, x, derivative: true), nx * pkg::spherical_yn(n, x) - pkg::spherical_yn(n + 1u32, x), 1e-13, f"y' at {n}, {x}");
            rel(pkg::spherical_in(n, x, derivative: true), pkg::spherical_in(n + 1u32, x) + nx * pkg::spherical_in(n, x), 1e-14, f"i' at {n}, {x}");
            rel(pkg::spherical_kn(n, x, derivative: true), nx * pkg::spherical_kn(n, x) - pkg::spherical_kn(n + 1u32, x), 1e-14, f"k' at {n}, {x}");
        }
    }
    expect(pkg::spherical_jn(0, 0.0) == 1.0 && pkg::spherical_jn(3, 0.0) == 0.0 && pkg::spherical_yn(2, 0.0) == f64::NEG_INFINITY, "x = 0");
    expect(pkg::spherical_jn(3, -2.0) == -pkg::spherical_jn(3, 2.0) && pkg::spherical_kn(1, -1.0) != pkg::spherical_kn(1, -1.0), "x < 0");
}

#[test]
fn airy() {
    for r in AIRY {
        let (a, ap, b, bp) = pkg::airy(r[0]);
        let got = [a, ap, b, bp];
        for k in 0..4 { close(got[k], r[1 + k], 4e-15 * r[5 + k], f"airy[{k}]({r[0]})"); }
        expect(pkg::ai(r[0]) == a && pkg::aip(r[0]) == ap && pkg::bi(r[0]) == b && pkg::bip(r[0]) == bp, "single forms");
    }
    // Ai Bi' - Ai' Bi = 1 / pi.
    for x in [-40.0, -9.9, -2.6, -2.4, -0.7, 0.0, 0.9, 1.5, 2.2, 6.0] {
        let (a, ap, b, bp) = pkg::airy(x);
        close(a * bp - ap * b, 0.3183098861837907, 1e-15 * ((a * bp).abs() + (ap * b).abs()), f"Airy Wronskian at {x}");
    }
    // The scaled forms.
    for x in [0.5, 3.0, 30.0] {
        let (a, ap, b, bp) = pkg::airy(x);
        let (ea, eap, eb, ebp) = pkg::airye(x);
        let z = 2.0 / 3.0 * x * x.sqrt();
        rel(ea, a * z.exp(), 1e-14, f"eAi at {x}");
        rel(eap, ap * z.exp(), 1e-14, f"eAi' at {x}");
        rel(eb, b * (-z).exp(), 1e-14, f"eBi at {x}");
        rel(ebp, bp * (-z).exp(), 1e-14, f"eBi' at {x}");
    }
    expect(pkg::airye(-3.0) == pkg::airy(-3.0), "unscaled for x < 0");
    expect(pkg::ai(200.0) == 0.0 && pkg::bi(200.0) == f64::INFINITY && pkg::airye(200.0).0 > 0.0, "overflow");
    expect(pkg::ai(f64::NAN) != pkg::ai(f64::NAN), "NaN");
}

#[test]
fn struve() {
    check3(SH.to_list(), |v: f64, x: f64| -> f64 { pkg::struve_h(v, x) }, 3e-15, "struve_h");
    check3(SL.to_list(), |v: f64, x: f64| -> f64 { pkg::struve_l(v, x) }, 1e-14, "struve_l");
    // H_1/2 = sqrt(2 / (pi x)) (1 - cos x), L_1/2 = sqrt(2 / (pi x)) (cosh x - 1)
    // (as 2 sinh(x/2)^2, without the cancellation).
    for x in [0.2, 3.0, 29.0, 31.0, 77.0] {
        let c = (2.0 / (3.141592653589793 * x)).sqrt();
        close(pkg::struve_h(0.5, x), c * (1.0 - x.cos()), 4e-16 * 2.0 * c, f"H_1/2 at {x}");
        rel(pkg::struve_l(0.5, x), 2.0 * c * (0.5 * x).sinh() * (0.5 * x).sinh(), 2e-15, f"L_1/2 at {x}");
    }
    expect(pkg::struve_h(1.0, -2.0) == pkg::struve_h(1.0, 2.0) && pkg::struve_h(0.0, -2.0) == -pkg::struve_h(0.0, 2.0), "x < 0, integer v");
    expect(pkg::struve_h(0.5, -2.0) != pkg::struve_h(0.5, -2.0) && pkg::struve_h(-2.0, 1.0) != pkg::struve_h(-2.0, 1.0), "outside the domain");
    expect(pkg::struve_h(0.0, 0.0) == 0.0 && pkg::struve_l(-1.0, 0.0) == 2.0 / 3.141592653589793, "x = 0");
}
